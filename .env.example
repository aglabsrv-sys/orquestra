# Copie este exemplo para ~/.orquestra/.env (fora do vault e do repositório).
# No Windows: %USERPROFILE%\.orquestra\.env
# O painel e a maioria dos coletores funcionam sem chaves.
# Não preencha este arquivo versionado com valores reais.

# Coletores YouTube pela API oficial; restrinja a chave no Google Cloud.
YOUTUBE_API_KEY=
